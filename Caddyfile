# Caddyfile — static-only, read-only site.
# Caddy listens on :80 inside the container; cloudflared terminates TLS at the
# Cloudflare edge and connects to this container over the private tunnel network.
# No public port is published from this container on the host (see docker-compose.yml).

:80 {
	root * /srv/dist
	file_server
	encode gzip zstd

	# Static site only — no PHP, no CGI, no reverse-proxying, no admin surface.

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Pages revalidate on every visit so updates show at once; assets keep a short cache.
	@pages path / *.html */
	header @pages Cache-Control "no-cache"
	@assets path *.webp *.mp4 *.css *.js *.svg *.png
	header @assets Cache-Control "public, max-age=3600"

	header {
		# TODO: tighten CSP if/when any external resources (fonts, analytics) are added.
		# Content-Security-Policy "default-src 'self'"
	}

	# TODO: add a real 404 page (e.g. src/pages/404.astro) and point it here once it exists.
	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}

	log {
		output stdout
		format console
	}
}
