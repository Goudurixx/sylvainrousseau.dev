# Copy to .env and fill in real values. .env is gitignored — never commit real secrets.

# Cloudflare Tunnel token (Zero Trust dashboard -> Networks -> Tunnels -> your
# tunnel -> "Install connector" step gives you this token). Required only on
# the NAS deployment; leave blank for local `docker compose up` testing.
# TODO: fill in on the NAS, from the Cloudflare dashboard.
CLOUDFLARE_TUNNEL_TOKEN=

# Host port caddy binds to on 127.0.0.1 (local-only). Defaults to 8080.
HOST_PORT=8080
