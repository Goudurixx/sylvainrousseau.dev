---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
const siteName = 'Sylvain Rousseau';
const path = Astro.url.pathname;
const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/#pulse', label: 'Pulse' },
  { href: '/#projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
  { href: '/cv', label: 'CV' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title === 'Home' ? `${siteName} · Engineer` : `${title} · ${siteName}`}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05070b" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@200;300;500&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="site-header">
      <nav>
        <a class="brand" href="/"><span class="brand-dot" aria-hidden="true"></span>Sylvain Rousseau</a>
        <div class="nav-links">
          {nav.map((n) => (
            <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
          ))}
        </div>
      </nav>
    </header>
    <main class={wide ? 'wide' : 'narrow'}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <span>&copy; {new Date().getFullYear()} Sylvain Rousseau</span>
        <span>Built with Astro.</span>
      </div>
    </footer>
  </body>
</html>
