---
import BaseLayout from '../layouts/BaseLayout.astro';
import { roles, education, skills, spoken, links } from '../data/career';
---

<BaseLayout
  title="CV"
  description="Sylvain Rousseau: technical lead and forward deployed engineer. Counter-UAS drones, ground control stations, edge AI, Android."
>
  <span class="eyebrow">Curriculum vitae</span>
  <h1>Sylvain Rousseau</h1>
  <p class="tagline">Senior software engineer · Technical lead. Embedded &amp; edge AI, systems &amp; C2 integration, Android. Paris.</p>
  <ul class="link-list">{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>

  <h2>Experience</h2>
  {roles.map((r) => (
    <div class="card">
      <div class="card-meta">{r.org} · {r.place} · {r.period}</div>
      <h3>{r.role}</h3>
      <p>{r.context}</p>
      {r.highlights.length > 0 && <ul>{r.highlights.map((h) => <li>{h}</li>)}</ul>}
    </div>
  ))}

  <h2>Independent project</h2>
  <div class="card">
    <h3>Self-hosted LLM inference</h3>
    <p>Distributed vLLM serving across two GPU edge nodes, running a 26B-parameter mixture-of-experts model on personal hardware.</p>
  </div>

  <h2>Skills</h2>
  {Object.entries(skills).map(([k, v]) => (
    <div class="card">
      <div class="card-meta">{k}</div>
      <div class="tags">{v.map((t) => <span class="tag">{t}</span>)}</div>
    </div>
  ))}
  <p class="section-note">Languages: {spoken.join(' · ')}</p>

  <h2>Education</h2>
  {education.map((e) => (
    <div class="card">
      <div class="card-meta">{e.school} · {e.period}</div>
      <h3>{e.what}</h3>
    </div>
  ))}
</BaseLayout>
