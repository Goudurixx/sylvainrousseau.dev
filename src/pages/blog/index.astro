---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Blog" description="Notes from building things: edge AI, embedded displays, Android and drones.">
  <span class="eyebrow"><span class="dot"></span>Notes</span>
  <h1>Blog</h1>
  <p class="tagline">What broke, what I learned, and how it got fixed.</p>

  <div class="post-cards">
    {posts.map((post) => (
      <a class="panel post-card" href={`/blog/${post.id}/`}>
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <h2>{post.data.title}</h2>
        <p>{post.data.description}</p>
        <span class="read">Read →</span>
      </a>
    ))}
  </div>
</BaseLayout>
